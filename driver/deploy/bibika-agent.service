[Unit]
Description=Bibika robot agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=dialout video render
WorkingDirectory=/home/pi/bibika-server
EnvironmentFile=/home/pi/bibika-server/bibika-agent.env
Environment=BIBIKA_VIDEO_WIDTH=640
Environment=BIBIKA_VIDEO_HEIGHT=480
Environment=BIBIKA_VIDEO_FPS=30
Environment=BIBIKA_SERIAL=/dev/serial/by-path/platform-xhci-hcd.0-usb-0:2:1.0-port0
Environment=BIBIKA_VIDEO=/dev/v4l/by-path/platform-xhci-hcd.1-usb-0:1:1.0-video-index0
ExecStart=/home/pi/bibika-server/bibika-agent
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
