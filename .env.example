BIBIKA_AGENT_TOKEN=replace-with-a-long-random-secret
BIBIKA_ROBOT_ID=default
BIBIKA_PUBLIC_IP=77.37.184.204
# TURN relay (required for video to work through restrictive NATs).
# Use a public address or DNS name, never 192.168.x.x.
BIBIKA_ICE_URLS=turn:turn.example.com:3478?transport=udp
BIBIKA_ICE_USERNAME=bibika
BIBIKA_ICE_CREDENTIAL=replace-with-a-long-random-secret
BIBIKA_ICE_TRANSPORT_POLICY=relay
